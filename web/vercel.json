{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.ts": { "maxDuration": 20, "includeFiles": "api/_data/**" } },
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ],
  "rewrites": [{ "source": "/((?!api/|data/|assets/).*)", "destination": "/index.html" }]
}
